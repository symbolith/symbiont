{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "${3rd}/luv/library",
      "$VIMRUNTIME/lua",
      "~/.local/share/nvim/plugged/plenary.nvim/lua",
      "~/.local/share/nvim/plugged/coop.nvim/lua",
      "lua"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": ["vim", "describe", "it", "before_each", "after_each", "pending"]
  }
}
